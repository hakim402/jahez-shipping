# Cleanup candidate only. Destructive schema application requires separate owner approval.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=shipping.jahez.online
DJANGO_CSRF_TRUSTED_ORIGINS=https://shipping.jahez.online
SHIPPING_BIND_PORT=18743
SHIPPING_IMAGE=jahez-shipping:0.9.0
SHIPPING_DATA_DIR=/data
# Configure only after validating the actual proxy peer; never trust arbitrary forwarding headers.
SHIPPING_TRUSTED_PROXY_IPS=
SHIPPING_BUSINESS_TIME_ZONE=Asia/Kabul
# Public contact number, including country code; leave empty to hide WhatsApp links.
SHIPPING_WHATSAPP_NUMBER=
SHIPPING_HSTS_SECONDS=0
# Increase only after real TLS checks; never includeSubDomains/preload for other sites.
CACHE_REDIS_URL=redis://redis:6379/1
# Keep the API key private. Enabling does not perform a live verification.
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_TEXT_MODEL=
GROQ_VISION_MODEL=
GROQ_TEXT_OUTPUT_MODE=schema
GROQ_VISION_OUTPUT_MODE=json
GROQ_MAX_TOKENS=4096
GROQ_VISION_MAX_TOKENS=512

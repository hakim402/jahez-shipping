# Phase 1 skeleton only: not approved for VPS deployment.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=shipping.jahez.online
DJANGO_CSRF_TRUSTED_ORIGINS=https://shipping.jahez.online
SHIPPING_BIND_PORT=18743
SHIPPING_DATA_DIR=/data
SHIPPING_BUSINESS_TIME_ZONE=Asia/Kabul
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1
TRACK17_ENABLED=false
# Keep the API key private. Enabling does not perform a live verification.
TRACK17_RECONCILE_SECONDS=21600
TRACK17_API_KEY=
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_TEXT_MODEL=
GROQ_VISION_MODEL=

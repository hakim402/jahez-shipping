DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=GENERATE_WITH_INIT_DEV_ENV
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:18744,http://127.0.0.1:18744
SHIPPING_DATA_DIR=/data
SHIPPING_BUSINESS_TIME_ZONE=Asia/Kabul
# Public contact number, including country code; leave empty to hide WhatsApp links.
SHIPPING_WHATSAPP_NUMBER=
# Empty by default. Only exact trusted proxy peer IPs; proxy must overwrite X-Real-IP.
SHIPPING_TRUSTED_PROXY_IPS=
CACHE_REDIS_URL=redis://redis:6379/1
# Keep the API key private. Enabling does not perform a live verification.
GROQ_ENABLED=false

GROQ_API_KEY=
GROQ_TEXT_MODEL=
GROQ_VISION_MODEL=
GROQ_TEXT_OUTPUT_MODE=schema
GROQ_VISION_OUTPUT_MODE=json
GROQ_MAX_TOKENS=4096
# Separate vision response budget; increase only within your account's model limits.
GROQ_VISION_MAX_TOKENS=512

msgstr "ملاحظات يدوية بالإنجليزية"

msgid "Manual status override"
msgstr "الحالة المحددة يدوياً"

msgid "More than one container was found. An explicit selection is required."
msgstr "عُثر على أكثر من حاوية. يجب اختيار الحاوية المطلوبة صراحةً."

msgid "Needs review"
msgstr "بحاجة إلى مراجعة"

msgid "On hold"
msgstr "متوقفة مؤقتاً"

msgid "Origin"
msgstr "مصدر الحدث"

msgid "Origin code"
msgstr "رمز ميناء المنشأ"


msgstr "انتهاء حجز التحديث"

msgid "Refresh failure code"
msgstr "رمز تعذر التحديث"

msgid "Revision"
msgstr "رقم المراجعة"

msgid "Select a container present in the carrier result."
msgstr "اختر حاوية موجودة في نتيجة الناقل."


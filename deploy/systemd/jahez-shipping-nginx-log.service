[Unit]
Description=JAHEZ Shipping Nginx error redaction
Requires=jahez-shipping-nginx-log.socket
After=jahez-shipping-nginx-log.socket
[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/jahez-shipping/deploy/nginx_error_log.py --systemd --output /var/log/jahez-shipping/error.jsonl
DynamicUser=yes
LogsDirectory=jahez-shipping
LogsDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
StandardOutput=null
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10
Restart=on-failure

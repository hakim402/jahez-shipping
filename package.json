{
  "name": "jahez-shipping-assets",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i frontend/styles.css -o static/css/site.css --minify && node scripts/copy_frontend.mjs",
    "watch": "tailwindcss -i frontend/styles.css -o static/css/site.css --minify --watch=always"
  },
  "devDependencies": {
    "tailwindcss": "4.3.3",
    "@tailwindcss/cli": "4.3.3",
    "@alpinejs/csp": "3.17.4"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0"
  }
}
